{
  "name": "vscode-aicmd",
  "displayName": "%displayName%",
  "description": "%description%",
  "version": "0.1.30",
  "publisher": "fefeding",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/fefeding/ai-cmd"
  },
  "homepage": "https://github.com/fefeding/ai-cmd#readme",
  "bugs": {
    "url": "https://github.com/fefeding/ai-cmd/issues"
  },
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "AI",
    "Other"
  ],
  "keywords": [
    "ssh",
    "ssh client",
    "remote ssh",
    "terminal",
    "terminal emulator",
    "shell",
    "local shell",
    "xterm",
    "rdp",
    "remote desktop",
    "windows remote desktop",
    "windows rdp",
    "desktop",
    "sftp",
    "file transfer",
    "zmodem",
    "ai",
    "ai agent",
    "llm",
    "devops",
    "linux",
    "windows",
    "server management",
    "remote development",
    "remote",
    "log monitoring",
    "command audit",
    "batch commands",
    "jump host",
    "agent",
    "ssh 终端",
    "远程桌面",
    "windows 远程桌面",
    "运维"
  ],
  "galleryBanner": {
    "color": "#0F4C75",
    "theme": "light"
  },
  "pricing": "Free",
  "qna": "marketplace",
  "icon": "resources/activity-icon.png",
  "main": "./dist/extension.js",
  "activationEvents": [
    "onWebviewPanel:aicmd.terminal",
    "onView:aicmd.explorer",
    "onCommand:aicmd.openTerminal",
    "onCommand:aicmd.connectionClicked",
    "onCommand:aicmd.refresh",
    "onCommand:aicmd.runSelection",
    "onCommand:aicmd.showSessions",
    "onCommand:aicmd.browseRemote",
    "onCommand:aicmd.searchConnection",
    "onCommand:aicmd.exportConnections",
    "onCommand:aicmd.importConnections",
    "onCommand:aicmd.setGroupMode"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "aicmd",
          "title": "AICmd",
          "icon": "resources/activity-icon.svg"
        }
      ]
    },
    "views": {
      "aicmd": [
        {
          "id": "aicmd.explorer",
          "name": "%view.connections%"
        }
      ]
    },
    "commands": [
      {
        "command": "aicmd.openTerminal",
        "title": "%command.openTerminal%",
        "category": "AICmd",
        "icon": "$(play)"
      },
      {
        "command": "aicmd.refresh",
        "title": "%command.refresh%",
        "category": "AICmd",
        "icon": "$(refresh)"
      },
      {
        "command": "aicmd.addConnection",
        "title": "%command.addConnection%",
        "category": "AICmd",
        "icon": "$(add)"
      },
      {
        "command": "aicmd.editConnection",
        "title": "%command.editConnection%",
        "category": "AICmd",
        "icon": "$(edit)"
      },
      {
        "command": "aicmd.deleteConnection",
        "title": "%command.deleteConnection%",
        "category": "AICmd",
        "icon": "$(trash)"
      },
      {
        "command": "aicmd.connectionClicked",
        "title": "%command.connectionClicked%"
      },
      {
        "command": "aicmd.runSelection",
        "title": "%command.runSelection%",
        "category": "AICmd",
        "icon": "$(run-all)"
      },
      {
        "command": "aicmd.showSessions",
        "title": "%command.showSessions%",
        "category": "AICmd",
        "icon": "$(list-unordered)"
      },
      {
        "command": "aicmd.browseRemote",
        "title": "%command.browseRemote%",
        "category": "AICmd",
        "icon": "$(folder-opened)"
      },
      {
        "command": "aicmd.searchConnection",
        "title": "%command.searchConnection%",
        "category": "AICmd",
        "icon": "$(search)"
      },
      {
        "command": "aicmd.exportConnections",
        "title": "%command.exportConnections%",
        "category": "AICmd",
        "icon": "$(cloud-download)"
      },
      {
        "command": "aicmd.importConnections",
        "title": "%command.importConnections%",
        "category": "AICmd",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "aicmd.setGroupMode",
        "title": "%command.setGroupMode%",
        "category": "AICmd",
        "icon": "$(group-by-ref-type)"
      }
    ],
    "keybindings": [
      {
        "command": "aicmd.runSelection",
        "key": "ctrl+alt+r",
        "mac": "cmd+alt+r",
        "when": "editorTextFocus"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "aicmd.addConnection",
          "when": "view == aicmd.explorer",
          "group": "navigation@1"
        },
        {
          "command": "aicmd.refresh",
          "when": "view == aicmd.explorer",
          "group": "navigation@2"
        },
        {
          "command": "aicmd.showSessions",
          "when": "view == aicmd.explorer",
          "group": "navigation@3"
        },
        {
          "command": "aicmd.searchConnection",
          "when": "view == aicmd.explorer",
          "group": "navigation@4"
        },
        {
          "command": "aicmd.exportConnections",
          "when": "view == aicmd.explorer",
          "group": "navigation@5"
        },
        {
          "command": "aicmd.importConnections",
          "when": "view == aicmd.explorer",
          "group": "navigation@6"
        },
        {
          "command": "aicmd.setGroupMode",
          "when": "view == aicmd.explorer",
          "group": "navigation@7"
        },
        {
          "command": "aicmd.browseRemote",
          "when": "view == aicmd.explorer",
          "group": "navigation@8"
        }
      ],
      "editor/context": [
        {
          "command": "aicmd.runSelection",
          "when": "editorTextFocus",
          "group": "navigation@100"
        }
      ],
      "view/item/context": [
        {
          "command": "aicmd.openTerminal",
          "when": "view == aicmd.explorer && viewItem == connection",
          "group": "inline"
        },
        {
          "command": "aicmd.editConnection",
          "when": "view == aicmd.explorer && viewItem == connection",
          "group": "inline@1"
        },
        {
          "command": "aicmd.deleteConnection",
          "when": "view == aicmd.explorer && viewItem == connection",
          "group": "inline@2"
        },
        {
          "command": "aicmd.editConnection",
          "when": "view == aicmd.explorer && viewItem == connection",
          "group": "connection@1"
        },
        {
          "command": "aicmd.deleteConnection",
          "when": "view == aicmd.explorer && viewItem == connection",
          "group": "connection@2"
        },
        {
          "command": "aicmd.browseRemote",
          "when": "view == aicmd.explorer && viewItem == connection",
          "group": "connection@3"
        }
      ],
      "commandPalette": [
        {
          "command": "aicmd.openTerminal"
        },
        {
          "command": "aicmd.connectionClicked",
          "when": "false"
        },
        {
          "command": "aicmd.editConnection",
          "when": "false"
        },
        {
          "command": "aicmd.deleteConnection",
          "when": "false"
        }
      ]
    },
    "configuration": {
      "title": "AICmd",
      "properties": {
        "aicmd.dataDir": {
          "type": "string",
          "default": "",
          "description": "%config.dataDir.description%"
        },
        "aicmd.startPort": {
          "type": "number",
          "default": 9802,
          "description": "%config.startPort.description%"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "node esbuild.js --production",
    "compile": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "type-check": "tsc --noEmit",
    "package": "vsce package",
    "publish": "vsce publish"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/vscode": "^1.75.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.23.1",
    "ovsx": "^1.2.0"
  }
}
