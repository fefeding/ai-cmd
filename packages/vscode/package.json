{
  "name": "vscode-aicmd",
  "displayName": "%displayName%",
  "description": "%description%",
  "version": "1.1.2",
  "publisher": "fefeding",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/fefeding/ai-cmd"
  },
  "homepage": "https://github.com/fefeding/ai-cmd#readme",
  "bugs": {
    "url": "https://github.com/fefeding/ai-cmd/issues"
  },
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "AI",
    "Other"
  ],
  "keywords": [
    "ssh",
    "ssh client",
    "remote ssh",
    "terminal",
    "terminal emulator",
    "shell",
    "local shell",
    "xterm",
    "rdp",
    "remote desktop",
    "windows remote desktop",
    "windows rdp",
    "desktop",
    "sftp",
    "file transfer",
    "zmodem",
    "ai",
    "ai agent",
    "llm",
    "devops",
    "linux",
    "windows",
    "server management",
    "remote development",
    "remote",
    "log monitoring",
    "command audit",
    "batch commands",
    "jump host",
    "agent",
    "ssh 终端",
    "远程桌面",
    "windows 远程桌面",
    "运维"
  ],
  "galleryBanner": {
    "color": "#0F4C75",
    "theme": "light"
  },
  "pricing": "Free",
  "qna": "marketplace",
  "icon": "resources/activity-icon.png",
  "main": "./dist/extension.js",
  "activationEvents": [
    "onWebviewPanel:aicmd.terminal"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "aicmd",
          "title": "AICmd",
          "icon": "resources/activity-icon.svg"
        }
      ]
    },
    "views": {
      "aicmd": [
        {
          "id": "aicmd.explorer",
          "name": "%view.connections%",
          "icon": "resources/activity-icon.svg"
        }
      ]
    },
    "commands": [
      {
        "command": "aicmd.openTerminal",
        "title": "%command.openTerminal%",
        "category": "AICmd",
        "icon": "$(play)"
      },
      {
        "command": "aicmd.refresh",
        "title": "%command.refresh%",
        "category": "AICmd",
        "icon": "$(refresh)"
      },
      {
        "command": "aicmd.addConnection",
        "title": "%command.addConnection%",
        "category": "AICmd",
        "icon": "$(add)"
      },
      {
        "command": "aicmd.editConnection",
        "title": "%command.editConnection%",
        "category": "AICmd",
        "icon": "$(edit)"
      },
      {
        "command": "aicmd.deleteConnection",
        "title": "%command.deleteConnection%",
        "category": "AICmd",
        "icon": "$(trash)"
      },
      {
        "command": "aicmd.connectionClicked",
        "title": "%command.connectionClicked%"
      },
      {
        "command": "aicmd.runSelection",
        "title": "%command.runSelection%",
        "category": "AICmd",
        "icon": "$(run-all)"
      },
      {
        "command": "aicmd.showSessions",
        "title": "%command.showSessions%",
        "category": "AICmd",
        "icon": "$(list-unordered)"
      },
      {
        "command": "aicmd.browseRemote",
        "title": "%command.browseRemote%",
        "category": "AICmd",
        "icon": "$(folder-opened)"
      },
      {
        "command": "aicmd.searchConnection",
        "title": "%command.searchConnection%",
        "category": "AICmd",
        "icon": "$(search)"
      },
      {
        "command": "aicmd.exportConnections",
        "title": "%command.exportConnections%",
        "category": "AICmd",
        "icon": "$(cloud-download)"
      },
      {
        "command": "aicmd.importConnections",
        "title": "%command.importConnections%",
        "category": "AICmd",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "aicmd.setGroupMode",
        "title": "%command.setGroupMode%",
        "category": "AICmd",
        "icon": "$(group-by-ref-type)"
      },
      {
        "command": "aicmd.copyMcpConfig",
        "title": "%command.copyMcpConfig%",
        "category": "AICmd",
        "icon": "$(clippy)"
      }
    ],
    "languageModelTools": [
      {
        "name": "aicmd_sessionInfo",
        "displayName": "AICmd: attached terminal",
        "modelDescription": "Reference to the single AICmd terminal attached to this conversation: name, type, host and user. Call this first. Then use aicmd_sessionRead / aicmd_sessionExec / aicmd_sessionOutput / aicmd_sessionInterrupt / aicmd_sessionDetach to operate it. No session id needed. No side effects.",
        "canBeReferencedInPrompt": true,
        "toolReferenceName": "aicmdInfo",
        "icon": "$(terminal)",
        "when": "aicmd.mcpBound",
        "inputSchema": { "type": "object", "properties": {}, "additionalProperties": false }
      },
      {
        "name": "aicmd_sessionRead",
        "displayName": "AICmd: read terminal screen",
        "modelDescription": "Read the recent screen output of the attached AICmd terminal WITHOUT running anything. Use before acting or after a command produced no visible output.",
        "canBeReferencedInPrompt": true,
        "toolReferenceName": "aicmdRead",
        "icon": "$(terminal)",
        "when": "aicmd.mcpBound",
        "inputSchema": {
          "type": "object",
          "properties": {
            "lines": { "type": "integer", "minimum": 10, "maximum": 400, "description": "How many trailing lines to return. Default 100." }
          },
          "additionalProperties": false
        }
      },
      {
        "name": "aicmd_sessionExec",
        "displayName": "AICmd: execute in terminal",
        "modelDescription": "Run a shell command in the attached AICmd terminal. The command is typed into the user's visible interactive shell and audited. Returns output and exit code. Use aicmd_sessionOutput if output is truncated.",
        "canBeReferencedInPrompt": true,
        "toolReferenceName": "aicmdExec",
        "icon": "$(terminal)",
        "when": "aicmd.mcpBound",
        "inputSchema": {
          "type": "object",
          "properties": {
            "command": { "type": "string", "description": "The shell command to run." },
            "timeoutMs": { "type": "integer", "minimum": 1000, "maximum": 300000, "description": "Max wait in milliseconds. Default 20000." }
          },
          "required": ["command"],
          "additionalProperties": false
        }
      },
      {
        "name": "aicmd_sessionOutput",
        "displayName": "AICmd: read remaining output",
        "modelDescription": "Read the next chunk of FULL output from the most recent aicmd_sessionExec. Use this instead of rerunning a command when output was truncated.",
        "canBeReferencedInPrompt": true,
        "toolReferenceName": "aicmdOutput",
        "icon": "$(terminal)",
        "when": "aicmd.mcpBound",
        "inputSchema": {
          "type": "object",
          "properties": {
            "offset": { "type": "integer", "minimum": 0, "description": "Character offset. Use the nextOffset from the previous chunk." },
            "length": { "type": "integer", "minimum": 1000, "maximum": 200000, "description": "Maximum characters to return. Default 20000." }
          },
          "additionalProperties": false
        }
      },
      {
        "name": "aicmd_sessionInterrupt",
        "displayName": "AICmd: interrupt terminal",
        "modelDescription": "Send Ctrl+C to the attached AICmd terminal to stop the foreground command. Use when a command timed out or a prompt is stuck.",
        "canBeReferencedInPrompt": true,
        "toolReferenceName": "aicmdInterrupt",
        "icon": "$(debug-stop)",
        "when": "aicmd.mcpBound",
        "inputSchema": { "type": "object", "properties": {}, "additionalProperties": false }
      },
      {
        "name": "aicmd_sessionDetach",
        "displayName": "AICmd: detach terminal",
        "modelDescription": "Detach the AICmd terminal from this conversation once the task is finished, so no further commands can run on it.",
        "canBeReferencedInPrompt": true,
        "toolReferenceName": "aicmdDetach",
        "icon": "$(close)",
        "when": "aicmd.mcpBound",
        "inputSchema": { "type": "object", "properties": {}, "additionalProperties": false }
      }
    ],
    "keybindings": [
      {
        "command": "aicmd.runSelection",
        "key": "ctrl+alt+r",
        "mac": "cmd+alt+r",
        "when": "editorTextFocus"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "aicmd.addConnection",
          "when": "view == aicmd.explorer",
          "group": "navigation@1"
        },
        {
          "command": "aicmd.refresh",
          "when": "view == aicmd.explorer",
          "group": "navigation@2"
        },
        {
          "command": "aicmd.showSessions",
          "when": "view == aicmd.explorer",
          "group": "navigation@3"
        },
        {
          "command": "aicmd.searchConnection",
          "when": "view == aicmd.explorer",
          "group": "navigation@4"
        },
        {
          "command": "aicmd.exportConnections",
          "when": "view == aicmd.explorer",
          "group": "navigation@5"
        },
        {
          "command": "aicmd.importConnections",
          "when": "view == aicmd.explorer",
          "group": "navigation@6"
        },
        {
          "command": "aicmd.setGroupMode",
          "when": "view == aicmd.explorer",
          "group": "navigation@7"
        },
        {
          "command": "aicmd.browseRemote",
          "when": "view == aicmd.explorer",
          "group": "navigation@8"
        }
      ],
      "editor/context": [
        {
          "command": "aicmd.runSelection",
          "when": "editorTextFocus",
          "group": "navigation@100"
        }
      ],
      "view/item/context": [
        {
          "command": "aicmd.openTerminal",
          "when": "view == aicmd.explorer && viewItem == connection",
          "group": "inline"
        },
        {
          "command": "aicmd.editConnection",
          "when": "view == aicmd.explorer && viewItem == connection",
          "group": "inline@1"
        },
        {
          "command": "aicmd.deleteConnection",
          "when": "view == aicmd.explorer && viewItem == connection",
          "group": "inline@2"
        },
        {
          "command": "aicmd.editConnection",
          "when": "view == aicmd.explorer && viewItem == connection",
          "group": "connection@1"
        },
        {
          "command": "aicmd.deleteConnection",
          "when": "view == aicmd.explorer && viewItem == connection",
          "group": "connection@2"
        },
        {
          "command": "aicmd.browseRemote",
          "when": "view == aicmd.explorer && viewItem == connection",
          "group": "connection@3"
        }
      ],
      "commandPalette": [
        {
          "command": "aicmd.openTerminal"
        },
        {
          "command": "aicmd.connectionClicked",
          "when": "false"
        },
        {
          "command": "aicmd.editConnection",
          "when": "false"
        },
        {
          "command": "aicmd.deleteConnection",
          "when": "false"
        }
      ]
    },
    "configuration": {
      "title": "AICmd",
      "properties": {
        "aicmd.dataDir": {
          "type": "string",
          "default": "",
          "description": "%config.dataDir.description%"
        },
        "aicmd.startPort": {
          "type": "number",
          "default": 9802,
          "description": "%config.startPort.description%"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "node esbuild.js --production",
    "compile": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "type-check": "tsc --noEmit",
    "package": "vsce package",
    "publish": "vsce publish"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/vscode": "^1.75.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.23.1",
    "ovsx": "^1.2.0"
  }
}
