{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Extension",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}/packages/vscode"
      ],
      "preLaunchTask": "build-vscode"
    },
    {
      "name": "Run Extension (CodeBuddy, no debug)",
      "type": "extensionHost",
      "request": "launch",
      "noDebug": true,
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}/packages/vscode"
      ],
      "preLaunchTask": "build-vscode"
    }
  ]
}
