{
  "appId": "com.aicmd.app",
  "productName": "AICmd",
  "copyright": "Copyright © 2025",
  "directories": {
    "output": "release"
  },
  "files": [
    "electron/**/*",
    "dist/**/*",
    "data/skills/*",
    "public/*",
    "server.js",
    "bootstrap.js",
    "package.json"
  ],

  "mac": {
    "category": "public.app-category.productivity",
    "target": [
      {
        "target": "dmg",
        "arch": ["x64", "arm64"]
      },
      {
        "target": "zip",
        "arch": ["x64", "arm64"]
      }
    ],
    "icon": "public/favicon.icns",
    "hardenedRuntime": true,
    "gatekeeperAssess": false,
    "identity": null,
    "_note_identity": "本地构建时留 null，让 electron-builder 从 keychain 自动发现 Developer ID 证书做正式签名；CI 环境无证书，由 scripts/electron-build.js 在 CI 时覆盖为 '-' 走 ad-hoc 签名（见 README『macOS 打开提示』，用户需 xattr -cr）",
    "entitlements": "build/entitlements.mac.plist",
    "entitlementsInherit": "build/entitlements.mac.plist"
  },
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": ["x64"]
      }
    ],
    "icon": "public/favicon.ico"
  },
  "linux": {
    "target": [
      {
        "target": "AppImage",
        "arch": ["x64"]
      }
    ],
    "category": "Utility",
    "icon": "public/favicon.png"
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true
  },
  "asar": true,
  "asarUnpack": [
    "**/*.node",
    "**/node_modules/node-pty/**/*",
    "**/node_modules/ssh2/**/*",
    "**/node_modules/cpu-features/**/*"
  ],
  "npmRebuild": false
}
